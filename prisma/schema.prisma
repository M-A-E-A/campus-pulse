// Campus Pulse — database schema
// Events are stored in UTC. Display happens in the campus time zone (CAMPUS_TZ).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  ORGANIZER
  ADMIN
}

enum EventStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  CANCELLED
}

enum RsvpStatus {
  CONFIRMED
  CANCELLED
  WAITLISTED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  // Secret URL token for the personal "all my events" ICS feed.
  // Rotating it invalidates the old feed link.
  calendarToken String? @unique
  createdAt    DateTime @default(now())

  memberships    ClubMember[]
  rsvps          Rsvp[]
  savedEvents    SavedEvent[]
  follows        Follow[]
  notifications  Notification[]
}

model Club {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  logo        String?
  createdAt   DateTime @default(now())

  members     ClubMember[]
  events      Event[]
  followers   Follow[]
}

// Ties an organizer to a club. Being in this table is what makes someone
// an organizer for that club's events.
model ClubMember {
  id       String   @id @default(cuid())
  userId   String
  clubId   String
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([userId, clubId])
}

model Category {
  id     String  @id @default(cuid())
  name   String  @unique
  events Event[]
}

model Event {
  id              String      @id @default(cuid())
  title           String
  description     String
  coverImage      String?
  startsAt        DateTime // UTC
  endsAt          DateTime // UTC
  location        String
  capacity        Int? // null = no limit
  status          EventStatus @default(DRAFT)
  rejectionReason String?
  clubId          String
  categoryId      String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])
  rsvps    Rsvp[]
  savedBy  SavedEvent[]
  notifications Notification[]

  @@index([status, startsAt])
  @@index([clubId])
}

model Rsvp {
  id           String     @id @default(cuid())
  userId       String
  eventId      String
  status       RsvpStatus @default(CONFIRMED)
  ticketCode   String     @unique // random, unguessable; encoded in the QR
  checkedInAt  DateTime? // set once at the door; never counted twice
  createdAt    DateTime   @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Nobody can RSVP to the same event twice, even across status changes.
  @@unique([userId, eventId])
  @@index([eventId, status])
}

model SavedEvent {
  id      String   @id @default(cuid())
  userId  String
  eventId String
  savedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
}

model Follow {
  id         String   @id @default(cuid())
  userId     String
  clubId     String
  followedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([userId, clubId])
}

// What kind of thing happened. The row stores the KIND plus a pointer to the
// event — never a rendered sentence. The app is trilingual (fr/en/ar), so a
// stored English string would be wrong for most readers; the message is built
// at read time in the viewer's locale, and the event title is pulled via the
// relation below.
enum NotificationType {
  WAITLIST_PROMOTED // you were on the waitlist; a seat opened up
  EVENT_REMINDER    // an event you're attending starts soon
  EVENT_CANCELLED   // an event you were attending was cancelled
  NEW_CLUB_EVENT   // a club you follow published a new event
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  // Optional: a reminder always points at an event, and so do the others in
  // practice, but the column stays nullable so a future type (e.g. a club
  // announcement) needn't fake a link.
  eventId   String?
  // Set only on rows a scheduler may re-generate ("reminder:24h", "reminder:1h").
  // The unique index below then makes the cron idempotent — re-running it can't
  // double-notify. One-off rows leave it null, and Postgres treats NULLs as
  // distinct in a unique index, so they're unconstrained by it.
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Deleting the event keeps the history readable: the message degrades to a
  // generic line instead of 404-ing the notification's link target.
  event Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  // The bell reads "unread, newest first" for one user — this index serves it.
  @@index([userId, readAt, createdAt])
  @@unique([userId, eventId, dedupeKey])
}
