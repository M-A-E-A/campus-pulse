# PostgreSQL connection string (Neon). Get it from your Neon dashboard.
# Neon gives you two strings — use the pooled one for serverless/Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# Cloudinary (optional in dev — without it, images are stored in public/uploads).
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=""

# Campus time zone used for display (events are stored in UTC).
CAMPUS_TZ="Africa/Casablanca"

# Creator traffic console — the special login for the /creator dashboard.
# Set your own values in .env (gitignored); both must be non-empty or the
# login door shows an honest "not configured" notice instead of a form.
CREATOR_LOGIN=""
CREATOR_PASSWORD=""
# Optional: sign the cp-creator cookie with its own secret instead of AUTH_SECRET.
# CREATOR_SESSION_SECRET=""
